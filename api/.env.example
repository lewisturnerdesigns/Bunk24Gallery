# MySQL connection (create bunk24_gallery in MySQL first)
DATABASE_URL="mysql://bunk24_app:replace-with-password@127.0.0.1:3306/bunk24_gallery"

# API
PORT=8000
PUBLIC_API_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRE_MINUTES=60
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
SEED_DEMO_DATA=false

# Stripe stays disabled until configured
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/checkout/success
STRIPE_CANCEL_URL=http://localhost:3000/shop
