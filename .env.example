# Local PostgreSQL (Docker Compose)
POSTGRES_DB=bunk24
POSTGRES_USER=bunk24
POSTGRES_PASSWORD=replace-with-a-long-local-password

# API
DATABASE_URL=postgresql+psycopg://bunk24:replace-with-a-long-local-password@db:5432/bunk24
FRONTEND_ORIGIN=http://localhost:3000
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes
JWT_EXPIRE_MINUTES=60
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

# Stripe remains disabled until configured. Never expose secret keys to NEXT_PUBLIC_*.
STRIPE_SECRET_KEY=
STRIPE_SUCCESS_URL=http://localhost:3000/checkout/success
STRIPE_CANCEL_URL=http://localhost:3000/shop
NEXT_PUBLIC_API_URL=http://localhost:8000
LOG_LEVEL=INFO
