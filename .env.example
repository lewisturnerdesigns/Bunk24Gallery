# Local PostgreSQL defaults for running the API directly on Windows.
# Copy this file to .env (never commit .env) and set the real local password.
POSTGRES_DB=bunk24_app
POSTGRES_USER=bunk24_app
POSTGRES_PASSWORD=replace-with-your-local-postgres-password

# SQLAlchemy URL for native local development. Docker Compose overrides this
# with its internal database hostname when the API runs inside Docker.
DATABASE_URL=postgresql+psycopg://bunk24_app:replace-with-your-local-postgres-password@127.0.0.1:5432/bunk24_app

# API
FRONTEND_ORIGIN=http://localhost:3000
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes
JWT_EXPIRE_MINUTES=60
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
SEED_DEMO_DATA=true

# Stripe remains disabled until configured. Never expose secret keys to NEXT_PUBLIC_*.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/checkout/success
STRIPE_CANCEL_URL=http://localhost:3000/shop
NEXT_PUBLIC_API_URL=http://localhost:8000
LOG_LEVEL=INFO
